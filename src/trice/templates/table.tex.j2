{#- A results table for the paper (booktabs). -#}
\begin{table}[t]
\centering
\caption{ {{- caption -}} }
\label{tab:{{ name }}}
\begin{tabular}{ {{- "l" * (columns | length) -}} }
\toprule
{{ columns | map("latex") | join(" & ") }} \\
\midrule
{% for row in rows -%}
{% for c in columns %}{{ row[c] | cell | latex }}{% if not loop.last %} & {% endif %}{% endfor %} \\
{% endfor -%}
\bottomrule
\end{tabular}
\end{table}
